{
  "name": "angular-ready-to-go-boilerplate",
  "version": "2.0.0",
  "description": "Production-ready Angular 22 boilerplate: auth, CRUD, file upload, Material 3, signals, zoneless.",
  "author": "Bhaskar Rajoriya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brnrajoriya/Angular-Boilerplate.git"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "start:stage": "ng serve -c stage",
    "build": "ng build",
    "build:stage": "ng build -c stage",
    "build:demo": "ng build -c production,demo",
    "watch": "ng build --watch -c development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "ci": "npm run format:check && npm run lint && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
